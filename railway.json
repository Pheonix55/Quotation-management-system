{
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "./build.sh"
    },
    "deploy": {
        "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT"
    },
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "mysql",
        "PORT": "8080",
        "NODE_VERSION": "20"
    }
}